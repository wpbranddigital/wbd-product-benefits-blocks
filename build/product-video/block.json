{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wbd/product-video",
  "version": "1.1.0",
  "title": "Product Video",
  "category": "wbd-product-benefits",
  "description": "Click-to-play videos of a WooCommerce product (YouTube, Vimeo or uploaded).",
  "keywords": [
    "video",
    "youtube",
    "vimeo",
    "woocommerce",
    "wbd"
  ],
  "textdomain": "wbd-product-benefits-blocks",
  "usesContext": [
    "postId",
    "postType"
  ],
  "attributes": {
    "productId": {
      "type": "number",
      "default": 0
    },
    "index": {
      "type": "number",
      "default": 0
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": [
    "file:./index.css",
    "wbd-pbb-product-videos"
  ]
}