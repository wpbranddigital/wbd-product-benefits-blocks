{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wbd/product-faqs",
  "version": "1.1.0",
  "title": "Product FAQs",
  "category": "wbd-product-benefits",
  "description": "Questions and answers for a WooCommerce product, as an accessible accordion.",
  "keywords": [
    "faq",
    "questions",
    "accordion",
    "woocommerce",
    "wbd"
  ],
  "textdomain": "wbd-product-benefits-blocks",
  "usesContext": [
    "postId",
    "postType"
  ],
  "attributes": {
    "productId": {
      "type": "number",
      "default": 0
    },
    "style": {
      "type": "string",
      "enum": [
        "",
        "accordion",
        "boxed",
        "minimal"
      ],
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "showHeading": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": [
    "file:./index.css",
    "wbd-product-faqs"
  ]
}